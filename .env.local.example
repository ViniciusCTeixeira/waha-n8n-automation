TZ=America/Sao_Paulo

LOCAL_N8N_PORT=5678
LOCAL_WAHA_PORT=3000
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379

N8N_VERSION=2.30.5
WAHA_IMAGE=devlikeapro/waha:gows-2026.6.2
WAHA_ENGINE=GOWS

POSTGRES_DB=n8n
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=GERADO_PELO_SETUP_LOCAL
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=GERADO_PELO_SETUP_LOCAL

REDIS_PASSWORD=GERADO_PELO_SETUP_LOCAL
N8N_ENCRYPTION_KEY=GERADO_PELO_SETUP_LOCAL

WAHA_API_KEY_PLAIN=GERADO_PELO_SETUP_LOCAL
WAHA_API_KEY_SHA512=GERADO_PELO_SETUP_LOCAL
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=GERADO_PELO_SETUP_LOCAL
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=GERADO_PELO_SETUP_LOCAL
WAHA_N8N_WEBHOOK_PATH=waha
WAHA_WEBHOOK_HMAC_KEY=GERADO_PELO_SETUP_LOCAL
WAHA_WEBHOOK_EVENTS=message,message.any,message.ack,session.status
