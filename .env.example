# Domínios existentes no DNS/Cloudflare
N8N_DOMAIN=n8n.seudominio.com
WAHA_DOMAIN=waha.seudominio.com
ACME_EMAIL=seu-email@exemplo.com
TZ=America/Sao_Paulo

# Canais de atualização (estável ou suporte estendido)
N8N_VERSION=stable
# O script setup.sh escolhe automaticamente a imagem ARM64 ou AMD64 do WAHA.
WAHA_IMAGE=devlikeapro/waha:gows-arm
WAHA_ENGINE=GOWS

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=GERADO_PELO_SETUP
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=GERADO_PELO_SETUP

# Redis
REDIS_PASSWORD=GERADO_PELO_SETUP

# n8n
N8N_ENCRYPTION_KEY=GERADO_PELO_SETUP

# WAHA
WAHA_API_KEY_PLAIN=GERADO_PELO_SETUP
WAHA_API_KEY_SHA512=GERADO_PELO_SETUP
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=GERADO_PELO_SETUP
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=GERADO_PELO_SETUP
WAHA_N8N_WEBHOOK_PATH=waha
WAHA_WEBHOOK_HMAC_KEY=GERADO_PELO_SETUP
WAHA_WEBHOOK_EVENTS=message,message.any,message.ack,session.status
